{
  "description": "codex-router native hooks (fail-open). Install by copying to ~/.codex/hooks.json and trusting them via /hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/zlx06/.codex-router/hooks/before_task.py\"",
            "commandWindows": "python \"C:/Users/zlx06/.codex-router/hooks/before_task.py\"",
            "timeout": 5,
            "statusMessage": "分析任务"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/zlx06/.codex-router/hooks/after_task.py\"",
            "commandWindows": "python \"C:/Users/zlx06/.codex-router/hooks/after_task.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/zlx06/.codex-router/hooks/session_end.py\"",
            "commandWindows": "python \"C:/Users/zlx06/.codex-router/hooks/session_end.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
