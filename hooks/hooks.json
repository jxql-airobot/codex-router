{
  "description": "codex-router advisory hooks (fail-open). Install by copying to ~/.codex/hooks.json and trusting them via /hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/before_task.py",
            "commandWindows": "python \"C:/Users/zlx06/Documents/Codex/2026-08-13/codex-deepseek-flash-pro-codex-ai/work/codex-router-github/hooks/before_task.py\"",
            "timeout": 5,
            "statusMessage": "分析任务"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/on_error.py",
            "commandWindows": "python \"C:/Users/zlx06/Documents/Codex/2026-08-13/codex-deepseek-flash-pro-codex-ai/work/codex-router-github/hooks/on_error.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/after_task.py",
            "commandWindows": "python \"C:/Users/zlx06/Documents/Codex/2026-08-13/codex-deepseek-flash-pro-codex-ai/work/codex-router-github/hooks/after_task.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
